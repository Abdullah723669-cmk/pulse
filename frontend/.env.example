# Frontend Environment Variables for Firebase & Render Backend

# When deployed on Firebase, point VITE_API_URL and VITE_SOCKET_URL to your deployed Render backend:
# VITE_API_URL=https://pulse-backend-api.onrender.com
# VITE_SOCKET_URL=https://pulse-backend-api.onrender.com

# For local development (leave empty or use relative / proxy or http://localhost:5000):
VITE_API_URL=
VITE_SOCKET_URL=
